<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flex & Grid Battle</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- ===== PHẦN 1: FLEXBOX - CĂN GIỮA HỘP NỘI DUNG ===== -->
  <section class="container">
    <div class="box">
      <h2>Flexbox Center</h2>
      <p>Hộp này được căn giữa màn hình cả theo chiều dọc và chiều ngang bằng Flexbox.</p>
    </div>
  </section>

  <!-- ===== PHẦN 2: CSS GRID - BỐ CỤC 3 CỘT ===== -->
  <section class="grid-section">
    <h2 class="grid-title">CSS Grid Layout (3 cột)</h2>
    <div class="grid-container">
      <div class="grid-item">Cột 1</div>
      <div class="grid-item">Cột 2</div>
      <div class="grid-item">Cột 3</div>
    </div>
  </section>

</body>
</html>
